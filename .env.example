# ============================================================
# Clinic Care System — MVP Environment Variables
# ============================================================
# Copy this file to .env and configure for your deployment:
#   cp .env.example .env
# ============================================================

# ---- Django Core Configuration ----
DJANGO_SETTINGS_MODULE=config.settings.production
DJANGO_SECRET_KEY=generate-a-secure-random-secret-key-at-least-50-characters-long
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,yourdomain.com

# ---- Database Configuration (SQLite Persistent Volume for MVP) ----
DATABASE_ENGINE=sqlite
DATABASE_NAME=data/db.sqlite3

# ---- JWT Authentication & Security Cookies ----
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=30
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7
JWT_COOKIE_SECURE=True
JWT_COOKIE_SAMESITE=Lax

# ---- CORS & CSRF Security ----
CORS_ALLOWED_ORIGINS=http://localhost,http://localhost:5173,https://yourdomain.com
CSRF_TRUSTED_ORIGINS=http://localhost,http://localhost:5173,https://yourdomain.com

# ---- OpenRouter AI Provider Integration ----
AI_PROVIDER=openrouter
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=qwen/qwen3-235b-a22b:free

# ---- Frontend Environment Variables ----
VITE_API_URL=/api/v1
VITE_APP_NAME=Clinic Care System

# ---- Logging ----
LOG_LEVEL=INFO
